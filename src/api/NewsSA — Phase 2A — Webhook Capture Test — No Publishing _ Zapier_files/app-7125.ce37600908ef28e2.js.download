m if you connected the right account.","messages-no-options-available-possible-reasons-partner-app-has-data":"Confirm that there is data in the partner app.","messages-no-options-available-possible-reasons-has-data-permission":"Confirm that you have permission to the data in the partner app.","messages-no-options-available-possible-reasons-data-retrieval-issue":"There was an issue retrieving data from the partner app. Please try again later."},"options-pane-human-in-the-loop-slack-authentication-connector":{"buttons-connect-new-account":"+ Connect a new account","buttons-connect-new-slack-account":"Connect a new Slack account"},"options-pane-option":{"buttons-go-to-top-folder":"Go to top folder","labels-id-prefix":"ID:","messages-last-used-time-ago":"Last used <emphasis>{relativeTime} ago</emphasis>","tooltip-show-subfolders-for-label":"Show subfolders for {label}","buttons-show-subfolders-for-label":"Show subfolders for {label}","tooltip-restricted-by-account-owner":"Restricted by account owner"},"options-pane-recently-used-choices":{"headings-recently-used-values":"Recently used values","buttons-clear-recently-used-values":"Clear"},"options-pane-search-results-count-indicator":{"messages-all-results-loaded":"All <countHighlight>{count}</countHighlight> results were loaded.","messages-loaded-results":"Loaded <countHighlight>{count}</countHighlight> results.","messages-unable-to-load-results":"Unable to load results. Try refreshing the page. {errorMessage}","tooltip-title-loaded-results":"Loaded results","tooltip-messages-search-within-loaded-results-only":"You can search only within loaded results.","tooltip-messages-load-more-to-search-more-items":"Load more to search for more items.","tooltip-messages-results-may-include-shared-and-personal-items":"Results may contain shared and personal items."},"paste-step-confirmation-modal":{"descriptions-missing-data-warning":"If you paste this step you’ll have to remove or replace the missing data on this and/or later steps