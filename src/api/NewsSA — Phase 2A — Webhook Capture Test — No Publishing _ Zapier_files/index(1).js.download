(()=>{var Ze=Object.defineProperty;var he=Object.getOwnPropertySymbols;var $e=Object.prototype.hasOwnProperty,Ve=Object.prototype.propertyIsEnumerable;var ue=(t,i,e)=>i in t?Ze(t,i,{enumerable:!0,configurable:!0,writable:!0,value:e}):t[i]=e,fe=(t,i)=>{for(var e in i||(i={}))$e.call(i,e)&&ue(t,e,i[e]);if(he)for(var e of he(i))Ve.call(i,e)&&ue(t,e,i[e]);return t};var y=(t,i,e)=>new Promise((a,o)=>{var H=m=>{try{s(e.next(m))}catch(L){o(L)}},O=m=>{try{s(e.throw(m))}catch(L){o(L)}},s=m=>m.done?a(m.value):Promise.resolve(m.value).then(H,O);s((e=e.apply(t,i)).next())});var ge=`
/* Container - ensures proper stacking context */
#zapier-chat-container {
  font-family: 'Inter', Helvetica, Arial, sans-serif;
  font-size: 14px;
  /* line-height removed \u2014 let Zinnia Body1-multiline handle typography */
  box-sizing: border-box;
}

#zapier-chat-container *,
#zapier-chat-container *::before,
#zapier-chat-container *::after {
  box-sizing: border-box;
}

/* Launcher button - circle by default, expands to oval on hover */
.zapier-chat-launcher {
  position: fixed;
  bottom: 24px;
  right: 24px;
  width: 48px;
  height: 48px;
  border-radius: 50px;
  background: #FFFDF9; /* Zinnia: --zds-background-weaker */
  border: 1px solid #D7D3C9; /* Zinnia: --zds-stroke-weaker */
  cursor: pointer;
  box-shadow: 0 2px 4px 0 rgba(32, 21, 21, 0.12);
  z-index: 2147483647;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  transition: width 0.25s ease, gap 0.25s ease, padding 0.25s ease, box-shadow 0.2s ease;
  padding: 12px;
  outline: none;
  overflow: hidden;
  white-space: nowrap;
}

/* "Copilot" label \u2014 hidden by default, revealed on hover */
.zapier-chat-launcher-label {
  font-size: 14px;
  font-weight: 500;
  color: #4F4844; /* Zinnia: --zds-text-default */
  max-width: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-width 0.3s ease, opacity 0.2s ease 0.05s;
}

.zapier-chat-launcher:hover {
  width: 116px;
  padding: 12px 10px 12px 8px;
  gap: 8px;
  box-shadow: 0 4px 8px 0 rgba(32, 21, 21, 0.16);
}

.zapier-chat-launcher:hover .zapier-chat-launcher-label {
  max-width: 80px;
  opacity: 1;
}

.zapier-chat-launcher:focus {
  box-shadow: 0 0 0 3px rgba(255, 79, 0, 0.2), 0 2px 4px 0 rgba(32, 21, 21, 0.12);
}

/* Faux Pilot (Support) chat launcher - purple brand variant. A round icon
   button that opens the faux-pilot pill menu; the labels
   ("Chat with Support" / "Screenshare with Support") live on the pills. */
.zapier-chat-launcher--faux-pilot {
  background: var(--zds-ui-primary, #847dfe);
  border: none;
  color: #ffffff;
  box-shadow: 0 2px 4px 0 rgba(32, 21, 21, 0.12);
}

.zapier-chat-launcher--faux-pilot:hover {
  background: var(--zds-ui-primary-stronger, #695be8);
  box-shadow: 0 4px 8px 0 rgba(32, 21, 21, 0.16);
  /* Round icon \u2014 opens the pill menu; no oval expansion */
  width: 48px;
  padding: 12px;
  gap: 0;
}

.zapier-chat-launcher--faux-pilot:focus {
  box-shadow: 0 0 0 3px rgba(132, 125, 254, 0.35), 0 2px 4px 0 rgba(32, 21, 21, 0.12);
}

.zapier-chat-launcher--faux-pilot svg {
  color: #ffffff;
  fill: #ffffff;
}

/* Copilot launcher - solid purple, AI gradient on hover (matches editor Copilot) */
.zapier-chat-launcher--copilot {
  background: var(--zds-ui-primary-stronger, #695be8);
  border: none;
  color: #ffffff;
  box-shadow: 0 2px 4px 0 rgba(32, 21, 21, 0.12);
  /* Round icon \u2014 opens the pane on click; no oval label expansion */
  width: 48px;
  padding: 12px;
  gap: 0;
}

/* Gradient overlay cross-faded on hover (gradients can't transition directly) */
.zapier-chat-launcher--copilot::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(
    140deg,
    #ffd16e 0%,
    #fea048 26%,
    #ff7f24 39%,
    #ff4f00 50%,
    #ff5789 61%,
    #f589dc 74%,
    #bbbce3 100%
  );
  opacity: 0;
  transition: opacity 0.2s ease;
  pointer-events: none;
}

.zapier-chat-launcher--copilot:hover::before,
.zapier-chat-launcher--copilot.zapier-chat-launcher--pills-open::before {
  opacity: 1;
}

.zapier-chat-launcher--copilot:hover,
.zapier-chat-launcher--copilot.zapier-chat-launcher--pills-open,
.zapier-chat-launcher--copilot.zapier-chat-launcher--pills-open:hover {
  /* Override the base hover/pills-open sizing; keep the round 48px icon */
  box-shadow: 0 4px 8px 0 rgba(32, 21, 21, 0.16);
  width: 48px;
  padding: 12px;
  gap: 0;
}

.zapier-chat-launcher--copilot:focus {
  box-shadow: 0 0 0 3px rgba(132, 125, 254, 0.35), 0 2px 4px 0 rgba(32, 21, 21, 0.12);
}

/* Keep the glyph above the gradient overlay and force it white in both states */
.zapier-chat-launcher--copilot svg {
  position: relative;
  z-index: 1;
  color: #ffffff;
  fill: #ffffff;
}

.zapier-chat-launcher:active {
  transform: scale(0.98);
}

.zapier-chat-launcher svg {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  /* Gradient fill is defined inline in the SVG */
}

/* Chat pane - expanded state */
/* Anchored to bottom-right, drag-resizable from left edge */
.zapier-chat-pane {
  position: fixed;
  bottom: 24px;
  right: 24px;
  width: 410px;
  height: calc(100vh - 100px);
  max-height: min(800px, calc(100vh - 48px)); /* Cap at 800px on large screens */
  min-width: 380px;
  max-width: 50vw;
  background: white;
  border: 1px solid #D7D3C9; /* Zinnia: --zds-stroke-weaker */
  border-radius: 16px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  z-index: 2147483646; /* Slightly below launcher so button stays on top */
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: zapier-chat-slide-in 0.2s ease-out;
  transition: width 0.25s ease, height 0.25s ease;
}

/* Disable transitions while drag-resizing */
.zapier-chat-pane.is-dragging {
  transition: none;
  user-select: none;
}

/* Resize handle - left edge of pane */
.zapier-chat-resize-handle {
  position: absolute;
  top: 0;
  left: 0;
  width: 6px;
  height: 100%;
  cursor: col-resize;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Subtle visual indicator: thin line on the handle */
.zapier-chat-resize-handle::after {
  content: "";
  display: block;
  width: 2px;
  height: 32px;
  border-radius: 1px;
  background: #D7D3C9; /* Zinnia: --zds-stroke-weaker */
  opacity: 0;
  transition: opacity 0.15s ease;
}

.zapier-chat-resize-handle:hover::after,
.zapier-chat-pane.is-dragging .zapier-chat-resize-handle::after {
  opacity: 1;
}

@keyframes zapier-chat-slide-in {
  from {
    opacity: 0;
    transform: translateX(20px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}


/* Chat body - contains the iframe */
.zapier-chat-body {
  flex: 1;
  overflow: hidden;
  padding: 0;
  background: #fafafa; /* Zinnia: --zds-background-default */
  position: relative;
}

/* Iframe */
.zapier-chat-iframe {
  width: 100%;
  height: 100%;
  border: none;
  display: block;
}

/* Loading indicator */
.zapier-chat-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: #fafafa; /* Zinnia: --zds-background-default */
  z-index: 1;
}

.zapier-chat-loading-spinner {
  box-sizing: border-box;
  width: 24px;
  height: 24px;
  border: 4px solid #88827e; /* Zinnia: --zds-gray-warm-6 */
  border-right-color: transparent;
  border-radius: 50%;
  opacity: 0.7;
  animation: zapier-chat-spin 3.5s ease-in-out infinite;
}

@media (prefers-reduced-transparency: reduce) {
  .zapier-chat-loading-spinner { opacity: 1; }
}

@media (prefers-reduced-motion: no-preference) {
  .zapier-chat-loading-spinner { animation: zapier-chat-spin 750ms linear infinite; }
}

.zapier-chat-sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@keyframes zapier-chat-spin {
  to {
    transform: rotate(360deg);
  }
}

/* Hidden state */
.zapier-chat-hidden {
  display: none !important;
}

/* Responsive adjustments for mobile */
@media (max-width: 480px) {
  .zapier-chat-pane {
    top: 0;
    bottom: 0;
    right: 0;
    width: 100vw;
    min-width: 0;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    border-radius: 0;
  }

  /* Hide resize handle on mobile \u2014 full-width pane */
  .zapier-chat-resize-handle {
    display: none;
  }

  .zapier-chat-launcher {
    bottom: 16px;
    right: 16px;
    width: 48px;
    height: 48px;
  }

}

/* Hide resize handle on medium screens \u2014 not enough drag range to be useful */
@media (min-width: 481px) and (max-width: 899px) {
  .zapier-chat-resize-handle {
    display: none;
  }
}

/* Keep launcher expanded as oval when pills are open */
.zapier-chat-launcher--pills-open,
.zapier-chat-launcher--pills-open:hover {
  width: 116px;
  padding: 12px 10px 12px 8px;
  gap: 8px;
  box-shadow: 0 4px 8px 0 rgba(32, 21, 21, 0.16);
}

.zapier-chat-launcher--pills-open .zapier-chat-launcher-label {
  max-width: 80px;
  opacity: 1;
}

/* Faux Pilot's launcher is an icon-only round button (no label), so keep it
   round when its pill menu is open instead of expanding to an empty oval. */
.zapier-chat-launcher--faux-pilot.zapier-chat-launcher--pills-open,
.zapier-chat-launcher--faux-pilot.zapier-chat-launcher--pills-open:hover {
  width: 48px;
  padding: 12px;
  gap: 0;
}

/* Pill menu - beside the 48px round launcher: 24px margin + 48px + 8px gap */
.zapier-chat-pill-menu {
  position: fixed;
  bottom: 24px;
  right: 80px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  z-index: 2147483647;
  animation: zapier-chat-pills-in 0.15s ease-out;
}

@keyframes zapier-chat-pills-in {
  from { opacity: 0; transform: translateX(6px); }
  to   { opacity: 1; transform: translateX(0); }
}

.zapier-chat-pill {
  height: 24px;
  padding: 0 8px;
  background: #FFFDF9;
  border: 1px solid #B5B2AA;
  border-radius: 4px;
  font-family: 'Inter', Helvetica, Arial, sans-serif;
  font-size: 13px;
  font-weight: 600;
  color: #695BE8;
  cursor: pointer;
  white-space: nowrap;
  display: flex;
  align-items: center;
  box-shadow: 0 1px 3px rgba(32, 21, 21, 0.08);
  transition: background 0.15s ease, box-shadow 0.15s ease;
  outline: none;
}

.zapier-chat-pill:hover {
  background: #F5F3EB; /* Zinnia: --zds-background-stronger */
  box-shadow: 0 2px 6px rgba(32, 21, 21, 0.12);
}

.zapier-chat-pill:focus {
  box-shadow: 0 0 0 3px rgba(105, 91, 232, 0.2);
}


